{
  "name": "idp-extraction-internvl",
  "imageName": "runpod/pytorch:2.2.0-py3.10-cuda12.1.1-devel-ubuntu22.04",
  "gpuTypeId": "NVIDIA A100 80GB PCIe",
  "gpuCount": 1,
  "volumeInGb": 50,
  "containerDiskInGb": 20,
  "env": {
    "MODEL": "OpenGVLab/InternVL3_5-8B-Flash",
    "PORT": "23333"
