  "ports": "23333/http,8003/http",
  "dockerStartCmd": "bash /workspace/deploy/runpod/start_lmdeploy.sh",
  "notes": "Deploy idp-extraction service alongside lmdeploy; set LMDEPLOY_URL=http://localhost:23333 MOCK_MODE=false"
}
