# Copy to .env.prod on app VM (do not commit .env.prod)
# Regenerate infra values: deploy/gcp/render-env-from-terraform.sh

COMPOSE_PROJECT_NAME=idp-prod

# --- GCP / Terraform ---
GCP_PROJECT_ID=nexts-system-idp-service
GCP_REGION=asia-southeast1
IDP_ENV=prod

ARTIFACTS_BUCKET=idp-dev-artifacts
REDIS_HOST=10.137.178.83
CLOUD_SQL_CONNECTION=nexts-system-idp-service:asia-southeast1:idp-dev-pg
APP_VM_IP=34.21.226.104
MONITORING_VM_IP=34.87.67.102

APP_SA_EMAIL=idp-dev-app@nexts-system-idp-service.iam.gserviceaccount.com
PREPROCESS_SA_EMAIL=idp-dev-preprocess@nexts-system-idp-service.iam.gserviceaccount.com
ORCHESTRATOR_SA_EMAIL=idp-dev-orch@nexts-system-idp-service.iam.gserviceaccount.com

# --- Database (Cloud SQL Auth Proxy sidecar in docker-compose.prod.yml) ---
DB_USER=idp
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://idp:CHANGE_ME@cloud-sql-proxy:5432/idp

# --- Redis (Memorystore private IP; only reachable from VPC / app VM) ---
REDIS_URL=redis://10.137.178.83:6379/0

# --- Secrets ---
CALLBACK_HMAC_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- Extraction (RunPod not ready: mock service on Docker network) ---
EXTRACTION_URL=http://idp-extraction:8003
MOCK_EXTRACTION=true
# When RunPod is ready, set:
# EXTRACTION_URL=https://<runpod-id>-8003.proxy.runpod.net
# MOCK_EXTRACTION=false
# RUNPOD_API_KEY=

# --- GCS artifacts (no emulator in prod) ---
GCS_BUCKET=idp-dev-artifacts

# --- Firebase input images (fill your invoice image bucket) ---
FIREBASE_PROJECT_ID=nexts-system-idp-service
FIREBASE_ALLOWED_BUCKETS=
ALLOWED_IMAGE_HOSTS=firebasestorage.googleapis.com,storage.googleapis.com

# SA key for preprocess GCS writes (create on VM: deploy/gcp/setup-vm-secrets.sh)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/preprocess-sa.json
SECRETS_DIR=/opt/idp/secrets
MODELS_DIR=/opt/idp/models

# --- DocTamper ---
DOCTAMPER_CHECKPOINT=/models/mit_unet_doctamper_best.pt
FRAUD_ENABLED=true
TAMPER_PIXEL_THRESHOLD=0.0001
MAX_IMAGE_EDGE=4096

# --- Orchestrator batching ---
BATCH_MAX_SIZE=48
BATCH_MAX_WAIT_MS=500
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30

# --- Docker images (leave IMAGE_REGISTRY empty to build on VM) ---
IMAGE_REGISTRY=
IMAGE_TAG=prod

# --- Observability (optional) ---
OTEL_EXPORTER_ENDPOINT=
